@page "/"

<PageTitle>Panel de Control - ECE FIAD</PageTitle>

<div class="container-fluid py-3">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-0">Panel de Control General</h2>
            <span class="text-muted">Sistema de Expediente Clínico Electrónico ECE-FIAD</span>
        </div>
        <div class="badge bg-light text-dark p-2 border fs-6">
            <i class="far fa-calendar-alt me-1"></i> @DateTime.Now.ToString("dddd, dd MMMM yyyy")
        </div>
    </div>

    <!-- Indicadores cuantitativos del hospital -->
    <div class="row g-4">
        <div class="col-md-6 col-lg-3">
            <div class="card-stats">
                <i class="fas fa-users icon-primary"></i>
                <h3 class="fw-bold">324</h3>
                <p class="text-muted mb-0">Pacientes Registrados</p>
            </div>
        </div>
        <div class="col-md-6 col-lg-3">
            <div class="card-stats">
                <i class="fas fa-calendar-check icon-success"></i>
                <h3 class="fw-bold">18</h3>
                <p class="text-muted mb-0">Citas Programadas Hoy</p>
            </div>
        </div>
        <div class="col-md-6 col-lg-3">
            <div class="card-stats">
                <i class="fas fa-user-md icon-info"></i>
                <h3 class="fw-bold">12</h3>
                <p class="text-muted mb-0">Médicos en Turno</p>
            </div>
        </div>
        <div class="col-md-6 col-lg-3">
            <div class="card-stats">
                <i class="fas fa-chart-line icon-warning"></i>
                <h3 class="fw-bold">89%</h3>
                <p class="text-muted mb-0">Índice de Asistencia</p>
            </div>
        </div>
    </div>

    <!-- Próximas consultas y notas clínicas -->
    <div class="row mt-4 g-4">
        <div class="col-lg-7">
            <div class="card-modern">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h5 class="fw-bold mb-0"><i class="fas fa-calendar-week me-2 text-primary"></i>Agenda Inmediata</h5>
                    <a href="/citas" class="btn btn-sm btn-link text-decoration-none">Ver agenda completa →</a>
                </div>
                <div class="table-responsive">
                    <table class="table table-modern">
                        <thead>
                            <tr>
                                <th>Paciente</th>
                                <th>Médico Asignado</th>
                                <th>Horario</th>
                                <th>Estatus</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td>Ana López</td>
                                <td>Dr. Martínez</td>
                                <td>10:00 AM</td>
                                <td><span class="badge bg-success">Confirmada</span></td>
                            </tr>
                            <tr>
                                <td>Carlos Ruiz</td>
                                <td>Dra. Gómez</td>
                                <td>11:30 AM</td>
                                <td><span class="badge bg-warning text-dark">Pendiente</span></td>
                            </tr>
                            <tr>
                                <td>María Paz</td>
                                <td>Dr. Fernández</td>
                                <td>12:15 PM</td>
                                <td><span class="badge bg-success">Confirmada</span></td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <div class="col-lg-5">
            <div class="card-modern">
                <h5 class="fw-bold mb-3"><i class="fas fa-notes-medical me-2 text-primary"></i>Notas de Evolución Recientes</h5>
                <div class="list-group list-group-flush">
                    <div class="list-group-item px-0 py-2 border-0">
                        <div class="fw-bold">Juan Pérez</div>
                        <small class="text-muted">Parámetros hemodinámicos estabilizados (120/80 mmHg).</small>
                    </div>
                    <div class="list-group-item px-0 py-2 border-0">
                        <div class="fw-bold">Luisa Gómez</div>
                        <small class="text-muted">Adecuada respuesta glucémica a tratamiento de soporte.</small>
                    </div>
                    <div class="list-group-item px-0 py-2 border-0">
                        <div class="fw-bold">Pedro Ramírez</div>
                        <small class="text-muted">Monitoreo posterior a intervención ambulatoria.</small>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>