@page "/alerts"
@inject IJSRuntime JSRuntime

<PageTitle>Prueba SweetAlert</PageTitle>

<div class="card p-4 shadow-sm">
    <h4 class="mb-2">Evaluación de Diálogo Modal (SweetAlert2)</h4>
    <p class="text-muted">Permite comprobar la captura asíncrona de decisiones del usuario.</p>
    <button class="btn btn-primary" style="max-width: 260px;" @onclick="MostrarConfirmacion">
        <i class="fas fa-trash-alt me-2"></i> Solicitar Confirmación
    </button>
</div>

@code {
    private async Task MostrarConfirmacion()
    {
        var confirmed = await JSRuntime.InvokeAsync<bool>(
            "SweetAlert.showConfirm",
            "¿Desea continuar?",
            "Esta operación registrará cambios permanentes en el sistema.",
            "warning",
            "Confirmar acción"
        );

        if (confirmed)
        {
            await JSRuntime.InvokeVoidAsync("Swal.fire", "Confirmado", "La solicitud fue procesada correctamente.", "success");
        }
        else
        {
            await JSRuntime.InvokeVoidAsync("Swal.fire", "Cancelado", "La operación ha sido desestimada.", "info");
        }
    }
}