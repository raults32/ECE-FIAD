@page "/crear-paciente"
@rendermode @(new InteractiveServerRenderMode(prerender: false))
<PageTitle>Registro de Paciente - ECE FIAD</PageTitle>

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-lg-9 col-md-11">
            <div class="card shadow-lg border-0 rounded-4">
                <div class="card-header bg-success bg-gradient text-white rounded-top-4">
                    <h5 class="mb-0 fw-bold">
                        <i class="fas fa-user-plus me-2"></i>Registro de Nuevo Paciente
                    </h5>
                </div>
                <div class="card-body p-4 bg-light">
                    <EditForm Model="@pacienteDto" OnValidSubmit="@GrabarPaciente">
                        <FluentValidator />
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label for="nombres" class="form-label fw-semibold">Nombres</label>
                                <InputText id="nombres" class="form-control" placeholder="Ej: Juan Carlos" @bind-Value="pacienteDto.Nombres" />
                                <ValidationMessage For="@(() => pacienteDto.Nombres)" class="text-danger small" />
                            </div>
                            <div class="col-md-6">
                                <label for="apellidos" class="form-label fw-semibold">Apellidos</label>
                                <InputText id="apellidos" class="form-control" placeholder="Ej: Pérez Gómez" @bind-Value="pacienteDto.Apellidos" />
                                <ValidationMessage For="@(() => pacienteDto.Apellidos)" class="text-danger small" />
                            </div>
                            <div class="col-md-6">
                                <label for="numeroDocumento" class="form-label fw-semibold">Número Documento</label>
                                <InputText id="numeroDocumento" class="form-control" placeholder="Ej: 12345678" @bind-Value="pacienteDto.NumeroDocumento" />
                                <ValidationMessage For="@(() => pacienteDto.NumeroDocumento)" class="text-danger small" />
                            </div>
                            <div class="col-md-6">
                                <label for="tipoDocumento" class="form-label fw-semibold">Tipo Documento</label>
                                <InputSelect id="tipoDocumento" class="form-select" @bind-Value="pacienteDto.TipoDocumento">
                                    @foreach (var item in EnumHelper.ObtenerOpcionesEnum<TipoDeDocumento>())
                                    {
                                        <option value="@item.Value">@item.Nombre</option>
                                    }
                                </InputSelect>
                                <ValidationMessage For="@(() => pacienteDto.TipoDocumento)" class="text-danger small" />
                            </div>
                            <div class="col-md-6">
                                <label for="telefono" class="form-label fw-semibold">Teléfono</label>
                                <InputText id="telefono" class="form-control" placeholder="Ej: 6461234567" @bind-Value="pacienteDto.Telefono" />
                                <ValidationMessage For="@(() => pacienteDto.Telefono)" class="text-danger small" />
                            </div>
                            <div class="col-md-6">
                                <label for="email" class="form-label fw-semibold">Email</label>
                                <InputText id="email" class="form-control" placeholder="Ej: juan@example.com" @bind-Value="pacienteDto.Email" />
                                <ValidationMessage For="@(() => pacienteDto.Email)" class="text-danger small" />
                            </div>
                            <div class="col-md-4">
                                <label for="fechaNacimiento" class="form-label fw-semibold">Fecha Nacimiento</label>
                                <InputDate id="fechaNacimiento" class="form-control" @bind-Value="pacienteDto.FechaNacimiento" />
                                <ValidationMessage For="@(() => pacienteDto.FechaNacimiento)" class="text-danger small" />
                            </div>
                            <div class="col-md-4">
                                <label for="genero" class="form-label fw-semibold">Género</label>
                                <InputSelect id="genero" class="form-select" @bind-Value="pacienteDto.Genero">
                                    @foreach (var item in EnumHelper.ObtenerOpcionesEnum<Genero>())
                                    {
                                        <option value="@item.Value">@item.Nombre</option>
                                    }
                                </InputSelect>
                            </div>
                            <div class="col-md-4">
                                <label for="grupoSanguineo" class="form-label fw-semibold">Grupo Sanguíneo</label>
                                <InputSelect id="grupoSanguineo" class="form-select" @bind-Value="pacienteDto.GrupoSanguineo">
                                    @foreach (var item in EnumHelper.ObtenerOpcionesEnum<GrupoSanguineo>())
                                    {
                                        <option value="@item.Value">@item.Nombre</option>
                                    }
                                </InputSelect>
                            </div>
                            <div class="col-md-12">
                                <label for="direccion" class="form-label fw-semibold">Dirección</label>
                                <InputText id="direccion" class="form-control" placeholder="Ej: Av. Reforma 123, Ensenada" @bind-Value="pacienteDto.Direccion" />
                            </div>
                        </div>
                        <div class="d-flex justify-content-end gap-2 mt-4">
                            <button type="button" class="btn btn-secondary px-4" @onclick="Cancelar">Cancelar</button>
                            <button type="submit" class="btn btn-success px-4 shadow-sm">Guardar Paciente</button>
                        </div>
                    </EditForm>
                </div>
            </div>
        </div>
    </div>
</div>
