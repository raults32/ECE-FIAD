@page "/detalles-paciente/{id:int}"
@rendermode @(new InteractiveServerRenderMode(prerender: false))
<PageTitle>Detalles del Paciente - ECE FIAD</PageTitle>

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-lg-8 col-md-10">
            <div class="card shadow-lg border-0 rounded-4">
                <div class="card-header bg-info text-white text-center rounded-top-4">
                    <h4 class="mb-0 fw-bold">Detalles del Paciente</h4>
                </div>
                <div class="card-body p-4 bg-light">
                    @if (paciente == null)
                    {
                        <div class="alert alert-warning text-center">Cargando información clínica...</div>
                    }
                    else
                    {
                        <div class="row mb-3 g-3">
                            <div class="col-md-3"><label class="small text-muted">Nombres</label><p class="fw-bold bg-white p-2 rounded border">@paciente.Nombres</p></div>
                            <div class="col-md-3"><label class="small text-muted">Apellidos</label><p class="fw-bold bg-white p-2 rounded border">@paciente.Apellidos</p></div>
                            <div class="col-md-3"><label class="small text-muted">F. Nacimiento</label><p class="fw-bold bg-white p-2 rounded border">@paciente.FechaNacimiento.ToString("dd/MM/yyyy")</p></div>
                            <div class="col-md-3"><label class="small text-muted">Género</label><p class="fw-bold bg-white p-2 rounded border">@EnumHelper.ObtenerNombreEnum(paciente.Genero)</p></div>
                        </div>
                        <div class="row mb-3 g-3">
                            <div class="col-md-3"><label class="small text-muted">No. Documento</label><p class="fw-bold bg-white p-2 rounded border">@paciente.NumeroDocumento</p></div>
                            <div class="col-md-3"><label class="small text-muted">Tipo Documento</label><p class="fw-bold bg-white p-2 rounded border">@EnumHelper.ObtenerNombreEnum(paciente.TipoDocumento)</p></div>
                            <div class="col-md-3"><label class="small text-muted">Teléfono</label><p class="fw-bold bg-white p-2 rounded border">@(string.IsNullOrEmpty(paciente.Telefono) ? "Sin registrar" : paciente.Telefono)</p></div>
                            <div class="col-md-3"><label class="small text-muted">Email</label><p class="fw-bold bg-white p-2 rounded border">@paciente.Email</p></div>
                        </div>
                        <div class="row mb-3 g-3">
                            <div class="col-md-4"><label class="small text-muted">Grupo Sanguíneo</label><p class="fw-bold bg-white p-2 rounded border text-danger">@EnumHelper.ObtenerNombreEnum(paciente.GrupoSanguineo)</p></div>
                            <div class="col-md-8"><label class="small text-muted">Dirección</label><p class="fw-bold bg-white p-2 rounded border">@(string.IsNullOrEmpty(paciente.Direccion) ? "Sin dirección registrada" : paciente.Direccion)</p></div>
                        </div>
                        <div class="mb-4">
                            <label class="small text-muted">Estado Clínico</label>
                            <p class="fw-bold bg-white p-2 rounded border">
                                @(paciente.Activo ? "Activo" : "Inactivo")
                            </p>
                        </div>
                        <div class="d-flex justify-content-end gap-2">
                            <button type="button" class="btn btn-secondary px-4" @onclick="Volver">Volver al listado</button>
                            <button type="button" class="btn btn-warning px-4 shadow-sm" @onclick="Editar">Editar paciente</button>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
