@page "/pacientes"
@rendermode @(new InteractiveServerRenderMode(prerender: false))

<PageTitle>Listado de Pacientes - ECE FIAD</PageTitle>

<div class="container mt-4">
    <div class="card shadow-lg border-0 rounded-4">
        <div class="card-header bg-primary text-white rounded-top-4">
            <div class="d-flex justify-content-between align-items-center">
                <h4 class="mb-0">
                    <i class="fas fa-users me-2"></i>Listado de Pacientes
                </h4>
                <button class="btn btn-success" @onclick="NavegarACrear">
                    <i class="fas fa-plus-circle me-1"></i> Nuevo Paciente
                </button>
            </div>
        </div>
        <div class="card-body p-3 bg-light">
            <div class="d-flex justify-content-end mb-3">
                <button class="btn btn-sm btn-warning shadow-sm" @onclick="CambiaEstilo">
                    <i class="@(EstiloCard ? "fas fa-list" : "fas fa-th") me-1"></i>
                    @(EstiloCard ? "Formato Listado" : "Formato Card")
                </button>
            </div>

            @if (pacientes == null)
            {
                <div class="text-center py-5">
                    <i class="fas fa-spinner fa-spin fa-2x text-primary"></i>
                    <p class="mt-2 text-muted">Cargando pacientes desde la base de datos...</p>
                </div>
            }
            else if (!pacientes.Any())
            {
                <div class="alert alert-info text-center shadow-sm">
                    <i class="fas fa-info-circle me-2"></i> No hay pacientes registrados actualmente.
                    <a href="javascript:void(0)" class="alert-link ms-1" @onclick="NavegarACrear">Registrar el primero</a>
                </div>
            }
            else
            {
                @if (EstiloCard)
                {
                    <div class="row g-4">
                        @foreach (var paciente in pacientes)
                        {
                            <div class="col-md-6 col-lg-4">
                                <div class="card-paciente shadow-sm h-100">
                                    <div class="d-flex align-items-center mb-3">
                                        <div class="bg-primary-subtle text-primary p-3 rounded-circle me-3">
                                            <i class="fas fa-user fs-4"></i>
                                        </div>
                                        <div>
                                            <h5 class="mb-0 fw-bold">@paciente.Nombres @paciente.Apellidos</h5>
                                            <small class="text-muted d-block"><i class="fas fa-id-card me-1"></i>@paciente.NumeroDocumento</small>
                                        </div>
                                    </div>
                                    <p class="mb-1 text-muted small"><i class="fas fa-envelope me-1"></i>@paciente.Email</p>
                                    <p class="mb-2 text-muted small"><i class="fas fa-phone me-1"></i>@(string.IsNullOrEmpty(paciente.Telefono) ? "Sin teléfono" : paciente.Telefono)</p>
                                    <hr class="my-2" />
                                    <div class="d-flex justify-content-between align-items-center">
                                        <span class="badge @(paciente.Activo ? "bg-success" : "bg-secondary")">
                                            @(paciente.Activo ? "Activo" : "Inactivo")
                                        </span>
                                        <div class="btn-group">
                                            <button class="btn btn-sm btn-info text-white" title="Ver detalles" @onclick="() => VerDetalles(paciente.Id)">
                                                <i class="fas fa-eye"></i>
                                            </button>
                                            <button class="btn btn-sm btn-warning" title="Editar" @onclick="() => Editar(paciente.Id)">
                                                <i class="fas fa-edit"></i>
                                            </button>
                                            <button class="btn btn-sm btn-danger" title="Eliminar" @onclick="() => ConfirmarEliminar(paciente.Id, paciente.Nombres, paciente.Apellidos)">
                                                <i class="fas fa-trash-alt"></i>
                                            </button>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="table-responsive bg-white rounded-3 shadow-sm">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>Nombre Completo</th>
                                    <th>N° Documento</th>
                                    <th>Email</th>
                                    <th>Estado</th>
                                    <th class="text-center">Acciones</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var paciente in pacientes)
                                {
                                    <tr>
                                        <td class="fw-semibold">@paciente.Nombres @paciente.Apellidos</td>
                                        <td>@paciente.NumeroDocumento</td>
                                        <td>@paciente.Email</td>
                                        <td>
                                            <span class="badge @(paciente.Activo ? "bg-success" : "bg-secondary")">
                                                @(paciente.Activo ? "Activo" : "Inactivo")
                                            </span>
                                        </td>
                                        <td class="text-center">
                                            <div class="btn-group">
                                                <button class="btn btn-sm btn-info text-white" title="Ver detalles" @onclick="() => VerDetalles(paciente.Id)">
                                                    <i class="fas fa-eye"></i>
                                                </button>
                                                <button class="btn btn-sm btn-warning" title="Editar" @onclick="() => Editar(paciente.Id)">
                                                    <i class="fas fa-edit"></i>
                                                </button>
                                                <button class="btn btn-sm btn-danger" title="Eliminar" @onclick="() => ConfirmarEliminar(paciente.Id, paciente.Nombres, paciente.Apellidos)">
                                                    <i class="fas fa-trash-alt"></i>
                                                </button>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            }
        </div>
    </div>
</div>
